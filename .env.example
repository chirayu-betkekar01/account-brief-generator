# Copy to .env (git-ignored) and fill in. Never put AWS access keys here:
# use an IAM Identity Center (SSO) profile or short-lived credentials instead.

# AWS CLI / SDK profile to use (created with `aws configure sso`)
AWS_PROFILE=discovery-sandbox
AWS_REGION=us-east-1

# Filled in AFTER deployment: `terraform -chdir=infra output -raw harness_arn`
HARNESS_ARN=

# Where budget alerts go. Only used by infra/bootstrap/terraform.tfvars (also git-ignored).
ALERT_EMAIL=you@example.com
